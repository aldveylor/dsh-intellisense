{
  "name": "@aldveylor/dsh-intellisense",
  "version": "0.3.1",
  "description": "Namespace-based DSML and isolated JavaScript/TypeScript execution with on-demand IntelliSense for DeepSeek Harness",
  "author": "aldveylor",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "intellisense",
    "dsml",
    "typescript",
    "javascript",
    "namespace",
    "code-execution",
    "agent-tools"
  ],
  "icon": "./assets/icon.svg",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/web/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json",
    "./icon": "./assets/icon.svg",
    "./client/icon": "./assets/icon.svg",
    "./presentation/icon": "./assets/icon.svg",
    "./presentation": {
      "types": "./dist/integration/presentation.d.ts",
      "default": "./dist/integration/presentation.js"
    },
    "./locale/*.json": "./locale/plugin/*.json",
    "./client/locale/*.json": "./locale/plugin/*.json",
    "./presentation/locale/*.json": "./locale/presentation/*.json",
    "./preset": {
      "types": "./dist/preset/index.d.ts",
      "default": "./dist/preset/index.js"
    },
    "./preset/icon": "./assets/icon.svg",
    "./preset/locale/*.json": "./locale/preset/*.json"
  },
  "files": [
    "dist",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh-cn.md",
    "LICENSE",
    "presets",
    "locale",
    "docs"
  ],
  "publishConfig": {
    "directory": "build/package",
    "linkDirectory": false
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-alpha.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:server": "node scripts/build.mjs server",
    "build:client": "node scripts/build.mjs client",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm run build && tsx --test tests/**/*.test.ts",
    "lint": "eslint --config scripts/eslint_config.mjs src tests",
    "prepare": "pnpm run build",
    "prepack": "node scripts/release/prepare_package.mjs",
    "screenshots": "pnpm run build && node scripts/screenshots.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "entities": "8.1.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-app-boot": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-storage-json": ">=0.2.2-alpha.2",
    "@eslint/js": "9.39.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "8.72.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-ptc-runtime": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-scope": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-storage": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-subagent": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": ">=0.2.2-alpha.2"
  },
  "optionalDependencies": {
    "minisearch": "7.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldveylor/dsh-intellisense.git"
  },
  "packageManager": "pnpm@12.14.0"
}
