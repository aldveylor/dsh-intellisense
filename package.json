{
  "name": "@aldveylor/dsh-intellisense",
  "version": "0.2.0",
  "description": "Namespace-based DSML and isolated JavaScript/TypeScript execution with on-demand IntelliSense for DeepSeek Harness",
  "author": "aldveylor",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "intellisense",
    "dsml",
    "typescript",
    "javascript",
    "namespace",
    "code-execution",
    "agent-tools"
  ],
  "icon": "./docs/icon.svg",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/management/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json",
    "./icon": "./docs/icon.svg",
    "./client/icon": "./docs/icon.svg",
    "./preset/icon": "./docs/icon.svg",
    "./namespace/icon": "./docs/icon.svg",
    "./presentation/icon": "./docs/icon.svg",
    "./preset": {
      "types": "./dist/integration/preset.d.ts",
      "default": "./dist/integration/preset.js"
    },
    "./namespace": {
      "types": "./dist/namespace/plugin.d.ts",
      "default": "./dist/namespace/plugin.js"
    },
    "./presentation": {
      "types": "./dist/integration/presentation.d.ts",
      "default": "./dist/integration/presentation.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "presets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json && esbuild src/runtime/worker.ts --bundle --platform=node --format=esm --outfile=dist/runtime/worker_bundle.mjs --target=node24 --minify",
    "build:client": "esbuild src/management/client.ts --bundle --platform=browser --format=cjs --loader:.css=text --external:react --external:react/jsx-runtime --external:@deepseek-ai/dsh-client-ui-primitives --target=es2022 --outfile=dist/client.js --banner:js=\"window.__ModuleLoader__.load({id:'dsh-intellisense',factory(require){const module={exports:{}};\" --footer:js=\"return module.exports;}});\" && esbuild src/management/standalone.tsx --bundle --platform=browser --format=iife --loader:.css=text --outfile=dist/management/standalone.js --target=es2022 --minify",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && tsx --test tests/**/*.test.ts",
    "lint": "eslint --config scripts/eslint_config.mjs src tests",
    "prepare": "npm run build",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "entities": "8.1.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@eslint/js": "9.39.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "8.72.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "optionalDependencies": {
    "minisearch": "7.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldveylor/dsh-intellisense.git"
  }
}
