{
  "name": "dsh-ts-intellisense",
  "version": "0.1.0",
  "description": "Fenced text execution with isolated JavaScript runtime and progressive IntelliSense for DeepSeek Harness",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/web/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json",
    "./preset": {
      "types": "./dist/text_ptc/preset.d.ts",
      "default": "./dist/text_ptc/preset.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "presets",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build_client.mjs",
    "typecheck": "tsc -p tests/tsconfig.json",
    "test": "npm run build && tsx --test tests/**/*.test.ts",
    "prepack": "npm run build",
    "lint": "eslint --config scripts/eslint_config.mjs src/llm_text_exec src/runtime_host src/text_ptc tests/llm_text_exec tests/text_ptc src/index.ts src/runtime/builtins.ts src/web/tree_provider.ts src/web/management_panel.tsx src/web/tool_picker src/web/routes.ts src/web/locale src/dsh/tool_commands.ts src/registry",
    "typecheck:text-exec": "tsc -p tests/llm_text_exec/tsconfig.json",
    "test:text-exec": "node --import tsx --test --test-timeout=10000 tests/llm_text_exec/*.test.ts",
    "test:active": "node --import tsx --test --test-timeout=20000 tests/llm_text_exec/*.test.ts tests/text_ptc/*.test.ts tests/web/unmounted_tools.test.ts",
    "typecheck:active": "tsc -p tests/text_ptc/tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "typescript": "5.9.3",
    "zod": "4.6.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@eslint/js": "9.39.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "8.72.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2"
  }
}
